{
  "name": "thingglance",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "description": "Know what's next for your things: warranties, subscriptions, support windows and the right moment to upgrade.",
  "homepage": "https://www.glance-apps.com/thingglance",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:android": "npm run build && cap sync android",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "pretest": "node stream-deck-plugin/scripts/gen-assets.mjs",
    "test": "vitest run",
    "test:e2e": "node e2e/vault-sync.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "./build-android.sh",
    "dev:electron": "npm run build:electron:main && concurrently -k -n renderer,main,preload,electron -c cyan,yellow,magenta,green \"vite --mode electron --port 5193 --strictPort\" \"tsc -p tsconfig.electron.json -w --preserveWatchOutput\" \"tsc -p tsconfig.electron.preload.json -w --preserveWatchOutput\" \"electronmon .\"",
    "build:electron:renderer": "tsc -b && vite build --mode electron",
    "build:electron:main": "tsc -p tsconfig.electron.json && tsc -p tsconfig.electron.preload.json",
    "build:electron": "npm run build:electron:renderer && npm run build:electron:main && electron-builder --config electron-builder.config.cjs",
    "build:electron:release": "npm run build:electron -- --publish never",
    "build:electron:dir": "npm run build:electron:renderer && npm run build:electron:main && electron-builder --config electron-builder.config.cjs --dir --publish never",
    "test:electron-smoke": "node e2e/electron-smoke.mjs",
    "test:electron-vault": "node e2e/electron-vault.mjs",
    "build:electron:mas": "npm run build:electron:renderer && npm run build:electron:main && THINGGLANCE_MAS_BUILD=1 electron-builder --config electron-builder.config.cjs --mac mas --universal --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@glance-apps/intents": "1.4.0",
    "@glance-apps/mcp-host": "0.2.0",
    "@glance-apps/sync": "2.4.0",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "dayjs": "^1.11.13",
    "dexie": "^4.4.2",
    "dexie-react-hooks": "^4.2.0",
    "i18next": "^26.7.2",
    "lucide-react": "1.31.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.1.13",
    "ws": "8.18.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@electron/notarize": "^3.1.2",
    "@eslint/js": "^9.39.5",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "electron": "^43.8.10",
    "electron-builder": "^26.18.0",
    "electronmon": "^2.0.4",
    "eslint": "^9.39.5",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.0",
    "postcss": "^8.5.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.3.4",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.7"
  },
  "main": "dist-electron/main.js",
  "electronmon": {
    "patterns": [
      "!src/**",
      "!public/**",
      "!dist/**",
      "!docs/**",
      "!e2e/**",
      "!electron/**",
      "!android/**",
      "!store-assets/**"
    ]
  }
}
