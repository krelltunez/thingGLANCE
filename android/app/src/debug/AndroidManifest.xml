<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- A test hook, in debug builds only: runs the routine background
             refresh now (scripts/android-check.mjs). -->
        <receiver
            android:name=".refresh.DebugRefreshReceiver"
            android:exported="true" />
        <!-- A test hook, in debug builds only: logs a RESULT sent back to this
             package, standing in for an automation app. -->
        <receiver
            android:name=".automation.DebugResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.thingglance.RESULT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
