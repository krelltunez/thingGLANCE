<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Developer ID build (docs/desktop.md): Hardened Runtime, not sandboxed. -->
<plist version="1.0">
  <dict>
    <!-- Electron's V8 JIT under Hardened Runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Electron loads its own unsigned executable memory. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Outbound network: GLANCEvault, the product lookups, the update check. -->
    <key>com.apple.security.network.client</key>
    <true/>
  </dict>
</plist>
