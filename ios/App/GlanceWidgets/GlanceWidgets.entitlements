<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The same group as App/App.entitlements, spelled the same: it is the
	     only way the widgets see what the app wrote. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.thingglance.app</string>
	</array>
</dict>
</plist>
