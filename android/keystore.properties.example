# Release signing for thingGLANCE on Android.
#
# Copy this to android/keystore.properties and fill it in. That file and the
# keystore itself are never committed (.gitignore), and nothing reads them
# but a release build (android/app/build.gradle).
#
# Make the keystore once, and keep it and its passwords somewhere that
# outlives this machine. With Play App Signing this is the UPLOAD key: Google
# holds the key users' installs are signed with, and can reset a lost upload
# key. Without Play App Signing, losing it means no more updates.
#
#   keytool -genkeypair -v -keystore ~/keys/thingglance-upload.jks \
#     -alias thingglance -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile is an absolute path, or one relative to the android/ directory.
# Keeping the keystore outside the repository is the safer of the two.
storeFile=/absolute/path/to/thingglance-upload.jks
storePassword=CHANGEME
keyAlias=thingglance
keyPassword=CHANGEME
